# ==============================================================================
# GAGAN SURAKSHA - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure local values as needed.
# NEVER commit real credentials, passwords, or tokens to version control.
# ==============================================================================

# 1. Project & Core API Settings
PROJECT_NAME="Gagan Suraksha Core API"
VERSION="1.0.0"
API_V1_PREFIX="/api"
HOST="127.0.0.1"
PORT=8000

# 2. Database Configuration (SQLite)
# Default persistent database path at repository root
DATABASE_URL="sqlite:///./gagan_suraksha.db"
SQL_ECHO=false

# 3. CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# 4. External Data Source Credentials (Optional - Space-Track.org)
# Register a free research/educational account at https://www.space-track.org
# If left empty, Space-Track adapter safely reports "Credentials required" status.
SPACETRACK_IDENTITY="your_spacetrack_email@example.com"
SPACETRACK_PASSWORD="your_spacetrack_password"

# 5. CelesTrak Ingestion Settings
CELESTRAK_AUTO_REFRESH=true
CELESTRAK_REFRESH_INTERVAL_HOURS=6
CELESTRAK_TIMEOUT_SECONDS=10

# 6. Conjunction Screening Parameters
SCREENING_TIME_HORIZON_HOURS=72
COARSE_FILTER_ALTITUDE_TOLERANCE_KM=50.0
CRITICAL_PC_THRESHOLD=1e-4
WARNING_PC_THRESHOLD=1e-5
DEFAULT_MISS_DISTANCE_THRESHOLD_KM=5.0

# 7. Notification Dispatchers (Optional)
# Email (SMTP)
NOTIFY_EMAIL=false
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="alerts@example.com"
SMTP_PASS="smtp_password_placeholder"
ALERT_EMAIL_RECIPIENT="mission-control@example.com"

# Telegram Bot
NOTIFY_TELEGRAM=false
TELEGRAM_BOT_TOKEN="000000000:placeholder_token"
TELEGRAM_CHAT_ID="placeholder_chat_id"

# ISRO ISTRAC Webhook
NOTIFY_ISTRAC_WEBHOOK=false
ISTRAC_WEBHOOK_URL="https://example.gov.in/api/v1/conjunction-alerts"
